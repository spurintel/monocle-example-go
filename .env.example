# Port the server listens on
PORT=8080

# Base64-encoded PEM contents of your Monocle deployment private key.
# Generate with:   cat monocle-key.pem | base64
PRIVATE_KEY=

# Your Monocle site token (from https://spur.us/app/monocle)
TOKEN=

# Test credentials for the example login form
USERNAME=alice
PASSWORD=alice

# Blocking strictness:
#   0 => Log only
#   1 => Block proxies
#   2 => Block VPNs
#   3 => Block VPNs and proxies
STRICTNESS_LEVEL=0
